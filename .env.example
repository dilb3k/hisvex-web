# In `next dev`, points at whatever backend you're running locally.
# In production, this (and NEXT_PUBLIC_API_BACKUP_URL below) are called
# directly from the browser — NOT through Vercel's old `/api/:path*` rewrite
# (see vercel.json; that rewrite is now unused by this client but left in
# place). The client fails over from primary to backup automatically on a
# 502/503/504 or connection failure and switches back once primary's own
# /health answers again — see src/lib/api.ts. No R2/Cloudflare keys belong
# here; image storage is entirely server-side (comp-bar-server).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Backup backend (comp-bar-server deployed a second time on Render, same
# MongoDB Atlas cluster as primary). Defaults to the production Render URL
# if unset — override only if you stand up a different backup.
NEXT_PUBLIC_API_BACKUP_URL=https://hisvex-api.onrender.com/api
