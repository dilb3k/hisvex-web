# Server-only — deliberately NOT NEXT_PUBLIC_* (that prefix bundles a value
# straight into client JS, visible to anyone in devtools/Network tab, which
# is exactly what these two used to do). Only src/app/api/[...path]/route.ts
# (the server-side proxy) reads these; the browser only ever calls this
# same origin's own /api/* path and never sees either real backend host.
# In `next dev`, point this at whatever backend you're running locally.
BACKEND_PRIMARY_URL=http://localhost:4000/api

# Backup backend (comp-bar-server deployed a second time on Render, same
# MongoDB Atlas cluster as primary). The proxy fails over to this
# server-side on a 502/503/504 or connection failure from primary — see
# src/app/api/[...path]/route.ts. Defaults to the production Render URL if
# unset; override only if you stand up a different backup.
BACKEND_BACKUP_URL=https://hisvex-api.onrender.com/api
